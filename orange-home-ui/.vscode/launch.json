{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Angular: Chrome (Full)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/src/*",
        "webpack:///*": "*",
        "webpack:///src/*": "${webRoot}/src/*"
      }
    },
    {
      "name": "Angular: Chrome (Attach)",
      "type": "chrome",
      "request": "attach",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    }
  ]
}
